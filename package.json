{
  "name": "ssl-cert-viewer",
  "displayName": "SSL Cert Viewer",
  "description": "A Visual Studio Code extension for viewing SSL certificate details.",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.50.0"
  },
  "activationEvents": [
    "onView:sslCertView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sslCertViewer.addCertificate",
        "title": "Add Certificate",
        "icon": "$(add)"
      },
      {
        "command": "sslCertViewer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sslCertViewer.clear",
        "title": "Clear All Certificates",
        "icon": "$(clear-all)"
      },
      {
        "command": "sslCertViewer.show",
        "title": "Show SSL Certificates"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "sslCertView",
          "name": "SSL Certificates"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sslCertViewer.addCertificate",
          "when": "view == sslCertView",
          "group": "navigation"
        },
        {
          "command": "sslCertViewer.refresh",
          "when": "view == sslCertView",
          "group": "navigation"
        },
        {
          "command": "sslCertViewer.clear",
          "when": "view == sslCertView"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.50.0",
    "@types/node": "^14.0.0",
    "typescript": "^4.9.5"
  }
}